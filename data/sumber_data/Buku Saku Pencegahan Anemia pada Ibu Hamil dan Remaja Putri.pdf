      photoshop:LayerText="Menstruasi menyebabkan remaja putri memiliki risiko yang lebih tinggi terhadap anemia. Apa yang perlu kita tahu tentang menstruasi?"/>
     <rdf:li
      photoshop:LayerName="Kalau ingin tahu lebih banyak tentang menstruasi, kamu bisa lih"
      photoshop:LayerText="Kalau ingin tahu lebih banyak tentang menstruasi, kamu bisa lihat di beberapa publikasi di link berikut (Kemdikbud, Kemenkes, Unicef; 2017) https://www.youtube.com/watch?v=ipTIsJf4QSg&amp;t=15s   https://www.youtube.com/watch?v=f-hdDbr4U-M&amp;t=4s  https://www.dropbox.com/s/udxibvq40db5n24/01%20-%20MHM%20booklet%20for%20Rural%20Final%20PMRC.pdf?dl=0 "/>
     <rdf:li
      photoshop:LayerName="1"
      photoshop:LayerText="1"/>
     <rdf:li
      photoshop:LayerName="2"
      photoshop:LayerText="2"/>
     <rdf:li
      photoshop:LayerName="3"
      photoshop:LayerText="3"/>
     <rdf:li
      photoshop:LayerName="4"
      photoshop:LayerText="4"/>
     <rdf:li
      photoshop:LayerName="5"
      photoshop:LayerText="5"/>
     <rdf:li
      photoshop:LayerName="Apa itu menstruasi?   Menstruasi adalah tanda anak perempuan tu"
      photoshop:LayerText="Apa itu menstruasi?   Menstruasi adalah tanda anak perempuan tumbuh menjadi dewasa, biasanya mulai terjadi pada usia 10-14 tahun. Saat menstruasi darah akan keluar dari vagina/kelamin secara alami, umumnya selama 3-7 hari, 1x sebulan  "/>
     <rdf:li
      photoshop:LayerName="Mengapa saat menstruasi kita terkadang merasa sakit?  Karena ra"
      photoshop:LayerText="Mengapa saat menstruasi kita terkadang merasa sakit?  Karena rahim berkontraksi untuk membantu meluruhkan lapisan yang akan keluar sebagai darah haid "/>
     <rdf:li
      photoshop:LayerName="Seberapa sering harus mengganti pembalut?  Sebaiknya setiap 3-4"
      photoshop:LayerText="Seberapa sering harus mengganti pembalut?  Sebaiknya setiap 3-4 jam sekali "/>
     <rdf:li
      photoshop:LayerName="Gimana caranya supaya kita nggak merasa lemes saat menstruasi? "
      photoshop:LayerText="Gimana caranya supaya kita nggak merasa lemes saat menstruasi?  Makan yang bergizi seperti sayur, buah dan protein hewani, serta minum air putih yang cukup.  Selain itu, remaja putri disarankan mengkonsumsi TTD seminggu sekali untuk mengganti darah yang hilang saat menstruasi"/>
     <rdf:li
      photoshop:LayerName="Gimana cara mengurangi rasa sakit saat menstruasi?  Minum air h"
      photoshop:LayerText="Gimana cara mengurangi rasa sakit saat menstruasi?  Minum air hangat, melakukan peregangan atau olah raga ringan.  Jika rasa sakitnya tidak tertahan, remaja bisa minum obat pereda rasa sakit setiap 6 jam sekali atau bisa bertanya ke petugas kesehatan terdekat "/>
     <rdf:li
      photoshop:LayerName="Menstruasi. Apa yang Kita Perlu tahu?"
      photoshop:LayerText="Menstruasi. Apa yang Kita Perlu tahu?"/>
     <rdf:li
      photoshop:LayerName="29"
      photoshop:LayerText="29"/>
     <rdf:li
      photoshop:LayerName="Sekarang Aku Tahu..."
      photoshop:LayerText="Sekarang Aku Tahu..."/>
     <rdf:li
      photoshop:LayerName="Penyebab utama anemia adalah kurang asupan zat besi"
      photoshop:LayerText="Penyebab utama anemia adalah kurang asupan zat besi"/>
     <rdf:li
      photoshop:LayerName="2"
      photoshop:LayerText="2"/>
     <rdf:li
      photoshop:LayerName="Remaja putri punya risiko lebih tinggi mengalami anemia karena "
      photoshop:LayerText="Remaja putri punya risiko lebih tinggi mengalami anemia karena kehilangan darah saat menstruasi"/>
     <rdf:li
      photoshop:LayerName="3"
      photoshop:LayerText="3"/>
     <rdf:li
      photoshop:LayerName="Cegah anemia sebelum muncul gejala dengan cara makan makanan su"
      photoshop:LayerText="Cegah anemia sebelum muncul gejala dengan cara makan makanan sumber zat besi dan minum TTD secara teratur"/>
     <rdf:li
      photoshop:LayerName="+"
      photoshop:LayerText="+"/>
     <rdf:li
      photoshop:LayerName="4"
      photoshop:LayerText="4"/>
     <rdf:li
      photoshop:LayerName="Bila anemia, kemampuan belajar dan kegiatan kita terganggu"
      photoshop:LayerText="Bila anemia, kemampuan belajar dan kegiatan kita terganggu"/>
     <rdf:li
      photoshop:LayerName="1"
      photoshop:LayerText="1"/>
     <rdf:li
      photoshop:LayerName="1 copy 2"
      photoshop:LayerText="1"/>
     <rdf:li
      photoshop:LayerName="Bila anemia, kemampuan belajar dan kegiatan kita terganggu copy"
      photoshop:LayerText="Bila anemia, kemampuan belajar dan kegiatan kita terganggu"/>
     <rdf:li
      photoshop:LayerName="30"
      photoshop:LayerText="30"/>
     <rdf:li
      photoshop:LayerName="Catatan"
      photoshop:LayerText="Catatan"/>
     <rdf:li
      photoshop:LayerName="31"
      photoshop:LayerText="31"/>
     <rdf:li
      photoshop:LayerName="Yuk, bersama kita cegah anemia"
      photoshop:LayerText="Yuk, bersama kita cegah anemia"/>
     <rdf:li
      photoshop:LayerName="Courtesy: Project Pencegahan Anemia Remaja Putri didukung oleh "
      photoshop:LayerText="Courtesy: Project Pencegahan Anemia Remaja Putri didukung oleh Global Affairs Canada, Kementerian Kesehatan Republik Indonesia, dan project MITRA Youth yang didukung oleh DFAT Australia."/>
    </rdf:Bag>
   </photoshop:TextLayers>
   <photoshop:DocumentAncestors>
    <rdf:Bag>
     <rdf:li>adobe:docid:photoshop:fd3048be-6d48-044f-b2fd-f22422b423ff</rdf:li>
     <rdf:li>xmp.did:018011740720681192B0ABFD5826142A</rdf:li>
    </rdf:Bag>
   </photoshop:DocumentAncestors>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>

