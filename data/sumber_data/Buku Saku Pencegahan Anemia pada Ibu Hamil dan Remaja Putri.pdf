     <rdf:li
      photoshop:LayerName="Menstruasi menyebabkan remaja putri memiliki risiko yang lebih "
      photoshop:LayerText="Menstruasi menyebabkan remaja putri memiliki risiko yang lebih tinggi terhadap anemia. Apa yang perlu kita tahu tentang menstruasi?"/>
     <rdf:li
      photoshop:LayerName="Kalau ingin tahu lebih banyak tentang menstruasi, kamu bisa lih"
      photoshop:LayerText="Kalau ingin tahu lebih banyak tentang menstruasi, kamu bisa lihat di beberapa publikasi di link berikut (Kemdikbud, Kemenkes, Unicef; 2017) https://www.youtube.com/watch?v=ipTIsJf4QSg&amp;t=15s   https://www.youtube.com/watch?v=f-hdDbr4U-M&amp;t=4s  https://www.dropbox.com/s/udxibvq40db5n24/01%20-%20MHM%20booklet%20for%20Rural%20Final%20PMRC.pdf?dl=0 "/>
